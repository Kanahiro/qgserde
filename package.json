{
  "name": "qgserde",
  "version": "0.3.0",
  "description": "Editable, information-preserving QGIS project XML for TypeScript",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kanahiro/qgserde.git"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": "^24.22.1 || ^26.12.1"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "node scripts/clean.ts && tsc -p tsconfig.build.json",
    "docs:build": "typedoc",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "node --experimental-strip-types --test src/*.test.ts",
    "test:integration": "node --experimental-strip-types --test test/*.test.ts",
    "check": "biome check .",
    "format": "biome check --write .",
    "prepack": "pnpm build",
    "demo:build": "esbuild demo/main.ts --bundle --format=esm --minify --loader:.qgs=text --outdir=docs/api/demo && cp demo/index.html docs/api/demo/"
  },
  "dependencies": {
    "saxes": "6.0.0",
    "xmlchars": "2.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "typedoc": "0.28.20",
    "typescript": "6.0.3"
  }
}
